
parameters:
    tmpDir: .phpstan
    level: 5

    paths:
        - tests

    parallel:
        maximumNumberOfProcesses: 4

    ignoreErrors:
        -
            identifier: property.uninitializedReadonly
        -
            identifier: catch.neverThrown
        -
            # Octane is optional and not installed here: its event ::class names are plain strings
            identifier: class.notFound
            message: '#^Class Laravel\\Octane\\Events\\\w+ not found\.$#'
            reportUnmatched: false
